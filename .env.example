PROJECT_NAME=Road700 Fleet Repairs
POSTGRES_DB=road700
POSTGRES_USER=road700
POSTGRES_PASSWORD=road700
# Host port for accessing the local Postgres container from the workstation.
POSTGRES_PORT=5432

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173
DATABASE_URL=
# Full public app URL, for example https://road700.example.com
PUBLIC_BASE_URL=
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
MAX_DOCUMENT_UPLOAD_SIZE_BYTES=26214400
MAX_IMPORT_UPLOAD_SIZE_BYTES=20971520
AUTH_LOGIN_RATE_LIMIT_WINDOW_SECONDS=600
AUTH_LOGIN_RATE_LIMIT_MAX_PER_IP=20
AUTH_LOGIN_RATE_LIMIT_MAX_PER_LOGIN=5
AUTH_PASSWORD_RESET_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX_PER_IP=10
AUTH_PASSWORD_RESET_RATE_LIMIT_MAX_PER_EMAIL=3
PASSWORD_RESET_TOKEN_TTL_MINUTES=60
INITIAL_ADMIN_FULL_NAME=System Administrator
INITIAL_ADMIN_LOGIN=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Road700
# Enable either TLS or SSL, but not both at the same time.
SMTP_USE_TLS=true
SMTP_USE_SSL=false

FRONTEND_PORT=5173
